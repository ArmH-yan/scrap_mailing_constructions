# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=developers
DB_USER=postgres
DB_PASS=postgres

# Scraper
SCRAPE_DELAY=0.5
SCRAPE_TIMEOUT=15
SCRAPE_MAX_RETRIES=3
MAX_WORKERS=5
BATCH_SIZE=100
RUN_INTERVAL_HOURS=6

# Zoho Mail SMTP (use smtp.zoho.eu if your Zoho account is in the EU data center;
# with 2FA on, SMTP_PASS must be an app-specific password)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=info@thenest.am
SMTP_PASS=your_app_password
SMTP_FROM_NAME=The Nest
SMTP_FROM_EMAIL=info@thenest.am
SEND_DELAY_SECONDS=20
DAILY_SEND_LIMIT=400

# Zoho IMAP — reply/bounce checking (python main.py --check-inbox).
# Defaults to the SMTP login; enable IMAP in Zoho Mail settings first.
IMAP_HOST=imap.zoho.com
IMAP_PORT=993
IMAP_LOOKBACK_DAYS=30

# Email
EMAIL_TEMPLATE_PATH=templates/email_template.html
TEST_EMAIL=your_email@gmail.com

# Link tracking (tracker/app.py). Leave TRACK_BASE_URL empty until the site is live:
# the template then has no website button and emails carry no tracked links.
TRACK_BASE_URL=
WEBSITE_URL=https://thenest.am
EMAIL_CAMPAIGN=outreach
TRACKER_PORT=8080
